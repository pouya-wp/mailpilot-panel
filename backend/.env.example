# All optional — the server starts with working defaults.
MAILPILOT_DB=./mailpilot.db
# Generate one for production; a per-install secret is written to .secret in dev
MAILPILOT_SECRET=
MAILPILOT_ACCESS_TTL_MIN=720
MAILPILOT_REFRESH_TTL_DAYS=30
MAILPILOT_CORS=http://localhost:4300,http://127.0.0.1:4300
MAILPILOT_SEED=true
MAILPILOT_DOCS=true
MAILPILOT_DEMO_EMAIL=pouya@acme.io
MAILPILOT_DEMO_PASSWORD=mailpilot
