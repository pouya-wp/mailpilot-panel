# ============ TTS service (server/tts.mjs) ============
# Which adapter to load: kokoro (quality) or piper (small VPS).
TTS_ENGINE=kokoro

# ---- kokoro ----
# Weights are pulled from HuggingFace on first run and cached on disk.
KOKORO_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX
# q8 ≈ 90MB and runs well on CPU. fp32 ≈ 326MB, better quality, slower.
KOKORO_DTYPE=q8
KOKORO_DEVICE=cpu
# Kokoro has its own voice set (am_* male US, af_* female US, bm_*/bf_* UK).
KOKORO_VOICE=am_michael
# Generation is CPU-heavy; 1 per 2 vCPU is a sane start.
KOKORO_CONCURRENCY=1

# ---- piper (only when TTS_ENGINE=piper) ----
# Absolute path to the voice; the matching .onnx.json must sit next to it.
# PIPER_MODEL=/opt/piper/voices/en_US-ryan-high.onnx
# PIPER_BIN=piper
# PIPER_CONCURRENCY=2

# ---- service ----
TTS_PORT=8787
TTS_HOST=127.0.0.1
# Rendered WAVs. Safe to delete at any time.
TTS_CACHE=./server/.cache
# Requests per minute per IP.
TTS_RATE=60
# Restrict CORS when the site is served from a different origin than the API.
# TTS_ORIGIN=https://panel.example.com

# ============ client ============
# Only needed if the API is not reachable at /api/tts on the same origin.
# VITE_TTS_URL=https://api.example.com/api/tts
